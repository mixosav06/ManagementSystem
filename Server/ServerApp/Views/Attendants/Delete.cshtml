@model ServerApp.Models.Attendant

@{
    ViewData["Title"] = "Видалити працівника";
}

<h2 class="text-danger">Видалення працівника</h2>
<h5 class="text-muted">Ви впевнені, що хочете видалити цього працівника?</h5>
<hr />

<div class="card border-danger shadow-sm col-md-8 mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8 fw-bold">@Model.ID</dd>

            <dt class="col-sm-4">Ім'я працівника</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>
        </dl>
    </div>
</div>

<form action="/Attendants/Delete/@Model.ID" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
    <a href="/Attendants" class="btn btn-secondary ms-2">Скасувати</a>
</form>