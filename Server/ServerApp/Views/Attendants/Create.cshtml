@model ServerApp.Models.Attendant

@{
    ViewData["Title"] = "Створити працівника";
}

<h2>Створити працівника</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form action="/Attendants/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">ПІБ / Ім'я працівника</label>
                <input name="Name" class="form-control" required placeholder="Олександр Петренко" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input name="Email" type="email" class="form-control" required placeholder="worker@example.com" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Пароль (Хеш)</label>
                <input name="PasswordHash" type="password" class="form-control" required placeholder="Введіть пароль" />
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Зберегти</button>
                <a href="/Attendants" class="btn btn-secondary ms-2">Назад до списку</a>
            </div>
        </form>
    </div>
</div>