@model ServerApp.Models.Attendant
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Додати працівника";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Створення нового працівника</h4>
                </div>
                <div class="card-body">
                    <form action="/Attendants/Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ім'я працівника</label>
                            <input name="Name" class="form-control" placeholder="Введіть ім'я" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input name="Email" type="email" class="form-control" placeholder="example@mail.com" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Пароль / Хеш</label>
                            <input name="PasswordHash" type="password" class="form-control" placeholder="Введіть пароль" required />
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a href="/Attendants" class="btn btn-outline-secondary">
                                Назад до списку
                            </a>
                            <button type="submit" class="btn btn-success">
                                Зберегти працівника
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>