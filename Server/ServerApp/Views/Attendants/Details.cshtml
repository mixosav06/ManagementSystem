@model ServerApp.Models.Attendant

@{
    ViewData["Title"] = "Деталі працівника";
}

<h2>Деталі працівника #@Model.ID</h2>
<hr />

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8 fw-bold">@Model.ID</dd>

            <dt class="col-sm-4">Ім'я працівника</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Хеш пароля</dt>
            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.PasswordHash</span></dd>
        </dl>
    </div>
    <div class="card-footer bg-light">
        <a href="/Attendants/Edit/@Model.ID" class="btn btn-warning">Редагувати</a>
        <a href="/Attendants" class="btn btn-secondary ms-2">Назад до списку</a>
    </div>
</div>