@model IEnumerable<ServerApp.Models.Attendant>

@{
    ViewData["Title"] = "Управління працівниками";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Управління працівниками</h2>
    <a href="/Attendants/Create" class="btn btn-primary">
        + Створити працівника
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Ім'я працівника</th>
                    <th>Email</th>
                    <th>Хеш пароля</th>
                    <th class="text-end pe-3">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold">@item.Name</td>
                        <td>@item.Email</td>
                        <td><span class="badge bg-secondary">@item.PasswordHash</span></td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="/Attendants/Edit/@item.ID" class="btn btn-outline-warning">Редагувати</a>
                                <a href="/Attendants/Details/@item.ID" class="btn btn-outline-info">Деталі</a>
                                <a href="/Attendants/Delete/@item.ID" class="btn btn-outline-danger">Видалити</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>