@model ServerApp.Models.Attendant

@{
    ViewData["Title"] = "Редагувати працівника";
}

<h2>Редагувати працівника #@Model.ID</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form action="/Attendants/Edit/@Model.ID" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ID" value="@Model.ID" />

            <div class="mb-3">
                <label class="form-label fw-bold">Ім'я працівника</label>
                <input name="Name" class="form-control" value="@Model.Name" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input name="Email" type="email" class="form-control" value="@Model.Email" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Пароль / Хеш пароля</label>
                <input name="PasswordHash" class="form-control" value="@Model.PasswordHash" required />
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-warning">Зберегти зміни</button>
                <a href="/Attendants" class="btn btn-secondary ms-2">Назад до списку</a>
            </div>
        </form>
    </div>
</div>