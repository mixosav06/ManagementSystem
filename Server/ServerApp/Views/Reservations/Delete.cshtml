@model ServerApp.Models.Reservation

@{
    ViewData["Title"] = "Видалити бронювання";
}

<h2 class="text-danger">Видалення бронювання</h2>
<h5 class="text-muted">Ви впевнені, що хочете видалити це бронювання?</h5>
<hr />

<div class="card border-danger shadow-sm col-md-8 mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID бронювання</dt>
            <dd class="col-sm-8 fw-bold">@Model.ID</dd>

            <dt class="col-sm-4">Працівник</dt>
            <dd class="col-sm-8">@(Model.User?.Name ?? $"ID: {Model.UserID}")</dd>

            <dt class="col-sm-4">Паркувальне місце</dt>
            <dd class="col-sm-8">@(Model.Spot?.Number ?? $"ID: {Model.SpotID}")</dd>

            <dt class="col-sm-4">Дата бронювання</dt>
            <dd class="col-sm-8">@Model.ReservationDate.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-4">Статус</dt>
            <dd class="col-sm-8">@Model.Status</dd>
        </dl>
    </div>
</div>

<form action="/Reservations/Delete/@Model.ID" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
    <a href="/Reservations" class="btn btn-secondary ms-2">Скасувати</a>
</form>