@model ServerApp.Models.Reservation

@{
    ViewData["Title"] = "Деталі бронювання";
}

<h2>Деталі бронювання #@Model.ID</h2>
<hr />

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID бронювання</dt>
            <dd class="col-sm-8 fw-bold">@Model.ID</dd>

            <dt class="col-sm-4">Працівник</dt>
            <dd class="col-sm-8">@(Model.User?.Name ?? $"ID: {Model.UserID}")</dd>

            <dt class="col-sm-4">Паркувальне місце</dt>
            <dd class="col-sm-8">@(Model.Spot?.Number ?? $"ID: {Model.SpotID}")</dd>

            <dt class="col-sm-4">Дата та час</dt>
            <dd class="col-sm-8">@Model.ReservationDate.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-4">Статус</dt>
            <dd class="col-sm-8">
                @if (Model.Status == "Active" || Model.Status == "Confirmed" || Model.Status == "Заброньовано")
                {
                    <span class="badge bg-success">@Model.Status</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Model.Status</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-light">
        <a href="/Reservations/Edit/@Model.ID" class="btn btn-warning">Редагувати</a>
        <a href="/Reservations" class="btn btn-secondary ms-2">Назад до списку</a>
    </div>
</div>