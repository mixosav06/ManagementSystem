@model IEnumerable<ServerApp.Models.ParkingSpot>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Паркувальні місця";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Управління паркувальними місцями</h2>
    <a href="/ParkingSpots/Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> + Створити паркомісце
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Номер місця</th>
                        <th>Статус</th>
                        <th class="text-end pe-4">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                Записи відсутні. Натисніть кнопку вище, щоб додати перше паркувальне місце.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.ID</td>
                                <td>@item.Number</td>
                                <td>
                                    @if (item.Status == "Free" || item.Status == "Вільне")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="/ParkingSpots/Edit/@item.ID" class="btn btn-outline-warning">Редагувати</a>
                                        <a href="/ParkingSpots/Details/@item.ID" class="btn btn-outline-info">Деталі</a>
                                        <a href="/ParkingSpots/Delete/@item.ID" class="btn btn-outline-danger">Видалити</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>