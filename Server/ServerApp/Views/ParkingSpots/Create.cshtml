@model ServerApp.Models.ParkingSpot
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Створити паркомісце";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Створення паркувального місця</h4>
                </div>
                <div class="card-body">
                    <form action="/ParkingSpots/Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Номер місця</label>
                            <input name="Number" class="form-control" placeholder="Наприклад: A-1 або 101" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Статус</label>
                            <select name="Status" class="form-select">
                                <option value="Free">Free (Вільне)</option>
                                <option value="Occupied">Occupied (Зайнято)</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a href="/ParkingSpots" class="btn btn-outline-secondary">
                                Назад до списку
                            </a>
                            <button type="submit" class="btn btn-success">
                                Зберегти місце
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>