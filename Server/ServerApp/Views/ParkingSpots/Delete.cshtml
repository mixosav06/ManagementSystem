@model ServerApp.Models.ParkingSpot

@{
    ViewData["Title"] = "Видалити паркомісце";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Видалення паркомісця</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-danger mb-3">Ви впевнені, що хочете видалити це місце?</h5>
                    <dl class="row">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8">@Model.ID</dd>

                        <dt class="col-sm-4">Номер місця:</dt>
                        <dd class="col-sm-8">@Model.Number</dd>

                        <dt class="col-sm-4">Статус:</dt>
                        <dd class="col-sm-8">@Model.Status</dd>
                    </dl>

                    <form action="/ParkingSpots/Delete/@Model.ID" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <div class="d-flex justify-content-between">
                            <a href="/ParkingSpots" class="btn btn-outline-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>