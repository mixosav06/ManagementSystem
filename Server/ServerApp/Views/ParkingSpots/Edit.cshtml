@model ServerApp.Models.ParkingSpot

@{
    ViewData["Title"] = "Редагувати паркомісце";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Редагування місця #@Model.ID</h4>
                </div>
                <div class="card-body">
                    <form action="/ParkingSpots/Edit/@Model.ID" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ID" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Номер місця</label>
                            <input name="Number" value="@Model.Number" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Статус</label>
                            <select name="Status" class="form-select">
                                <option value="Free" selected="@(Model.Status == "Free" ? "selected" : null)">Free (Вільне)</option>
                                <option value="Occupied" selected="@(Model.Status == "Occupied" ? "selected" : null)">Occupied (Зайнято)</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a href="/ParkingSpots" class="btn btn-outline-secondary">Назад</a>
                            <button type="submit" class="btn btn-warning">Зберегти зміни</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>