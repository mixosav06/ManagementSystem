@model ServerApp.Models.ParkingSpot

@{
    ViewData["Title"] = "Деталі паркомісця";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Інформація про паркомісце #@Model.ID</h4>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8">@Model.ID</dd>

                        <dt class="col-sm-4">Номер місця:</dt>
                        <dd class="col-sm-8">@Model.Number</dd>

                        <dt class="col-sm-4">Статус:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Status == "Free" ? "bg-success" : "bg-danger")">
                                @Model.Status
                            </span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a href="/ParkingSpots" class="btn btn-outline-secondary">Назад</a>
                    <a href="/ParkingSpots/Edit/@Model.ID" class="btn btn-warning">Редагувати</a>
                </div>
            </div>
        </div>
    </div>
</div>