<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClientApp.ViewModels"
             x:Class="ClientApp.Views.ItemsPage"
             Title="Паркувальні місця"
             BackgroundColor="#F4F9F5">

    <ContentPage.BindingContext>
        <vm:ItemsViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*, Auto" Padding="15">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" 
                            Padding="15" 
                            Stroke="#A5D6A7" 
                            StrokeThickness="1.5" 
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 10">
                        <HorizontalStackLayout Spacing="15">
                            <Label Text="{Binding Number, StringFormat='Місце #{0}'}" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="#1B5E20"/>
                            <Label Text="{Binding Status}" 
                                   FontSize="16" 
                                   TextColor="#2E7D32"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" 
                Text="Забронювати місце" 
                Command="{Binding GoToActionCommand}" 
                BackgroundColor="#2E7D32" 
                TextColor="White" 
                CornerRadius="8"
                Margin="0,10,0,0"/>
    </Grid>
</ContentPage>