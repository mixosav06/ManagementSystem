<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClientApp.ViewModels"
             x:Class="ClientApp.Views.LoginPage"
             Title="Вхід працівника"
             BackgroundColor="#F4F9F5">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label Text="Паркувальна Система" 
               FontSize="26" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="#1B5E20" />

        <Entry Placeholder="Email" 
               Text="{Binding Email}" 
               Keyboard="Email" 
               TextColor="#1B5E20" 
               PlaceholderColor="#81C784"
               BackgroundColor="White" />

        <Entry Placeholder="Пароль" 
               Text="{Binding Password}" 
               IsPassword="True" 
               TextColor="#1B5E20" 
               PlaceholderColor="#81C784"
               BackgroundColor="White" />

        <Button Text="Увійти" 
                Command="{Binding LoginCommand}" 
                BackgroundColor="#2E7D32" 
                TextColor="White" 
                CornerRadius="8"
                Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>